# VOLMERRA backend configuration
#
# The site is static: these values are NOT read automatically.
# Copy them into assets/js/config.js (see config.example.js).
# They are kept here for tooling and for a future server-side
# deployment.
#
# Where to get them: Supabase dashboard → Project Settings → API
#   Project URL  -> VOLMERRA_SUPABASE_URL
#   anon public  -> VOLMERRA_SUPABASE_ANON_KEY   (public, safe for browsers)

VOLMERRA_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VOLMERRA_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
